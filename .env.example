# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# App URLs
# ---------------------------------------------------------------------------
ADMIN_URL=http://localhost:3000
API_URL=http://localhost:4000
STOREFRONT_INTERNAL_URL=http://localhost:3001
STORE_ROOT_DOMAIN=altyapi.store
CUSTOM_DOMAIN_CNAME_TARGET=stores.altyapi.store
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Reverse proxies in front of the API; the client IP is taken this many hops from the socket (0 = no proxy).
API_TRUSTED_PROXY_HOPS=1
# Admin panel (apps/admin): storefront origin for "View store" and preview links; {host} is the
# store's hostname. Production: https://{host}. Local dev storefront: http://{host}:3001 (needs
# *.altyapi.store resolving to 127.0.0.1).
STOREFRONT_ORIGIN_TEMPLATE=https://{host}
# Admin panel: reverse proxies in front of the admin that append to X-Forwarded-For (default 1).
# The client IP forwarded to the API for rate limiting is read from the entry the outermost one
# wrote, never from a value the browser sent.
ADMIN_TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# PostgreSQL (Aurora PostgreSQL compatible)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://altyapi:altyapi@localhost:5432/altyapi
DATABASE_READ_URL=
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Redis / Valkey
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=altyapi:

# ---------------------------------------------------------------------------
# Queue (postgres driver for local, sqs for AWS)
# ---------------------------------------------------------------------------
QUEUE_DRIVER=postgres
SQS_EVENTS_QUEUE_URL=
SQS_JOBS_QUEUE_URL=
SQS_DEAD_LETTER_QUEUE_URL=
QUEUE_MAX_ATTEMPTS=8

# ---------------------------------------------------------------------------
# Cloudflare (DNS, Cloudflare for SaaS, R2, Image Transformations)
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_KV_ROUTING_NAMESPACE_ID=
CUSTOM_DOMAIN_APEX_A_RECORDS=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Local S3-compatible endpoint (e.g. MinIO http://localhost:9000); leave empty for Cloudflare R2
R2_ENDPOINT=
R2_BUCKET_STOREFRONT_PUBLIC=storefront-public
R2_BUCKET_MERCHANT_PRIVATE=merchant-private
R2_BUCKET_IMPORTS_TEMPORARY=imports-temporary
R2_BUCKET_EXPORTS_TEMPORARY=exports-temporary
R2_BUCKET_AUDIT_ARCHIVE=audit-archive
MEDIA_PUBLIC_BASE_URL=
# openssl rand -hex 32
EDGE_ROUTING_SECRET=change-me-change-me-change-me-change-me-0000
# openssl rand -hex 32 (shared by api and storefront, server-side only)
STOREFRONT_API_SECRET=change-me-change-me-change-me-change-me-1111

# ---------------------------------------------------------------------------
# AWS (KMS envelope encryption, Secrets Manager)
# ---------------------------------------------------------------------------
AWS_REGION=eu-central-1
SECRETS_DRIVER=local
KMS_KEY_ID=
# Development only: openssl rand -base64 32
LOCAL_MASTER_KEY=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
SESSION_COOKIE_NAME=altyapi_session
SESSION_TTL_HOURS=336
COOKIE_DOMAIN=
# openssl rand -hex 32
APP_SIGNING_SECRET=change-me-change-me-change-me-change-me-0000

# ---------------------------------------------------------------------------
# AI providers (panel AI command surface) and MCP connector
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=
MCP_ISSUER_URL=http://localhost:4000
MCP_ACCESS_TOKEN_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Kârmatik
# ---------------------------------------------------------------------------
KARMATIK_API_URL=
KARMATIK_API_KEY=
KARMATIK_TIMEOUT_MS=3000

# ---------------------------------------------------------------------------
# Yanıt
# ---------------------------------------------------------------------------
YANIT_API_URL=
YANIT_API_KEY=
YANIT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Ekosistem v1 bridge (docs/ekosistem/v1.md). Static peer bases per environment;
# https only, http/localhost accepted only with APP_ENV=local. Per-store link secrets
# are stored encrypted in the database; KARMATIK_API_KEY / YANIT_API_KEY are not used.
# ---------------------------------------------------------------------------
# altyapi's own public base (before /ekosistem/v1); defaults to API_URL.
EKOSISTEM_PUBLIC_BASE=
# e.g. https://karmatik.io/api/public
EKOSISTEM_PEER_BASE_KARMATIK=
# e.g. https://yanit.io/api
EKOSISTEM_PEER_BASE_YANIT=
# Reverse proxies in front of the API (load balancer, CDN). The client IP used for the
# claim (10/min) and pre-verification (300/min) limits is taken this many hops from the socket.
EKOSISTEM_TRUSTED_PROXY_HOPS=1

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# ---------------------------------------------------------------------------
# Service ports
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
WORKER_CONCURRENCY=8
WORKER_HEALTH_PORT=4100
# Meta Conversions API Graph version (server-side purchase events)
META_GRAPH_API_VERSION=v24.0
