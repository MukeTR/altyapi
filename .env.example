# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# App URLs
# ---------------------------------------------------------------------------
ADMIN_URL=http://localhost:3000
API_URL=http://localhost:4000
STOREFRONT_INTERNAL_URL=http://localhost:3001
STORE_ROOT_DOMAIN=altyapi.store
CUSTOM_DOMAIN_CNAME_TARGET=stores.altyapi.store
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# PostgreSQL (Aurora PostgreSQL compatible)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://altyapi:altyapi@localhost:5432/altyapi
DATABASE_READ_URL=
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# ---------------------------------------------------------------------------
# Redis / Valkey
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=altyapi:

# ---------------------------------------------------------------------------
# Queue (postgres driver for local, sqs for AWS)
# ---------------------------------------------------------------------------
QUEUE_DRIVER=postgres
SQS_EVENTS_QUEUE_URL=
SQS_JOBS_QUEUE_URL=
SQS_DEAD_LETTER_QUEUE_URL=
QUEUE_MAX_ATTEMPTS=8

# ---------------------------------------------------------------------------
# Cloudflare (DNS, Cloudflare for SaaS, R2, Image Transformations)
# ---------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_STOREFRONT_PUBLIC=storefront-public
R2_BUCKET_MERCHANT_PRIVATE=merchant-private
R2_BUCKET_IMPORTS_TEMPORARY=imports-temporary
R2_BUCKET_EXPORTS_TEMPORARY=exports-temporary
R2_BUCKET_AUDIT_ARCHIVE=audit-archive
MEDIA_PUBLIC_BASE_URL=
# openssl rand -hex 32
EDGE_ROUTING_SECRET=change-me-change-me-change-me-change-me-0000

# ---------------------------------------------------------------------------
# AWS (KMS envelope encryption, Secrets Manager)
# ---------------------------------------------------------------------------
AWS_REGION=eu-central-1
SECRETS_DRIVER=local
KMS_KEY_ID=
# Development only: openssl rand -base64 32
LOCAL_MASTER_KEY=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
SESSION_COOKIE_NAME=altyapi_session
SESSION_TTL_HOURS=336
COOKIE_DOMAIN=
# openssl rand -hex 32
APP_SIGNING_SECRET=change-me-change-me-change-me-change-me-0000

# ---------------------------------------------------------------------------
# AI providers (panel AI command surface) and MCP connector
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=
MCP_ISSUER_URL=http://localhost:4000
MCP_ACCESS_TOKEN_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Kârmatik
# ---------------------------------------------------------------------------
KARMATIK_API_URL=
KARMATIK_API_KEY=
KARMATIK_TIMEOUT_MS=3000

# ---------------------------------------------------------------------------
# Yanıt
# ---------------------------------------------------------------------------
YANIT_API_URL=
YANIT_API_KEY=
YANIT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# ---------------------------------------------------------------------------
# Service ports
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
WORKER_CONCURRENCY=8
WORKER_HEALTH_PORT=4100
